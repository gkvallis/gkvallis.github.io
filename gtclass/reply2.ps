/reencdef {
  findfont /tmp 1 index maxlength 1 add dict def _cf
% tmp /PaintType 1 put
  tmp /Encoding 3 index load put
  tmp definefont
  pop pop
} def

/pdfmark where
{pop} {userdict /pdfmark /cleartomark load put} ifelse

/Filter
{
   pop % Remove the size
   currentfile exch dup type /arraytype eq ([) print
   {{dup = filter} forall} { dup = filter } ifelse
   (]) print cvx exec
} bd

/TeXscale { 65536 div } def

/DocumentInitState [ matrix currentmatrix currentlinewidth currentlinecap
currentlinejoin currentdash currentgray currentmiterlimit ] cvx def

/gexsc 1 def
/disablepdfmarks true def

/:startTexFig {
% usage :  x y bb-llx bb-lly bb-urx bb-ury startFig
        %300 72 div dup scale  %%GR

        devicematrix dup 4 0 put dup 5 0 put matrix invertmatrix concat
        userdict maxlength dict begin
        /SavedState save def

        currentpoint transform

        disablepdfmarks {userdict /pdfmark /cleartomark load put} if

        DocumentInitState
        setmiterlimit setgray setdash setlinejoin setlinecap
                setlinewidth concat %setmatrix

        itransform moveto

        /ury exch TeXscale def
        /urx exch TeXscale def
        /lly exch TeXscale def
        /llx exch TeXscale def
        /y exch TeXscale def
        /x exch TeXscale def
        /top exch def

        currentpoint /cy exch def /cx exch def

        /sx x urx llx sub div def       % scaling for x
        /sy y ury lly sub div def       % scaling for y

        sx sy scale                     % scale by (sx,sy)

        cx sx div llx gexsc div sub
        cy sy div top {lly} {ury} ifelse gexsc div sub translate
%       cx sx div llx 1 div sub
%       cy sy div top {lly} {ury} ifelse 1 div sub translate

        /DefFigCTM matrix currentmatrix def

        /initmatrix {
                DefFigCTM setmatrix
        } def
        /defaultmatrix {
                DefFigCTM exch copy
        } def
        /initgraphics {
                DocumentInitState setmiterlimit setgray setdash
                        setlinejoin setlinecap setlinewidth setmatrix
                DefFigCTM setmatrix
        } def

        /showpage {initgraphics} def
% /erasepage and /copypage added for MatLab support (tli)
        /erasepage {initgraphics} def
        /a4 {initgraphics} def
        /a4small {initgraphics} def
        /b5 {initgraphics} def
        /ledger {initgraphics} def
        /legal {initgraphics} def
        /letter {initgraphics} def
        /lettersmall {initgraphics} def
        /copypage {} def
%        newpath
        /dict@count countdictstack def % Count objects on dict stack
        count /op@count exch def % Count objects on operand stack
} def

% llx lly urx ury clipFig -
% (in figure coordinates)
/clipFig
{
   currentpoint 6 2 roll
   newpath 4 copy
   4 2 roll moveto
   6 -1 roll exch lineto
   exch lineto
   exch lineto
   closepath clip
   newpath
   moveto
} bd

% doclip, if called, will always be just after a `startTexFig'
/doclip { llx lly urx ury clipFig } bd
%/endTexFig {end} bd

/:endTexFig {
        count op@count sub dup 0 gt
        {
          dup 8 string cvs
          (\n! VTeX PS warning: junk on operand stack, ) print
          print ( item\(s\). Removing...\n) print flush
          {pop} repeat % Clean up Op stack
        } {pop} ifelse
        countdictstack dict@count sub dup 0 gt
        {
          dup 8 string cvs
          (\n! VTeX PS warning: junk on dictionary stack, ) print
          print ( item\(s\). Removing...\n) print flush
          {end} repeat % Clean up Dict stack
        } {pop} ifelse
        SavedState restore
        end
} def

