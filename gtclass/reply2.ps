      {exch GetTrueName exch def} repeat
      cleartomark
      /ImageMatrix [Width 0 0 Height neg 0 Height] def
      currentdict end
      dup /ImageMask known not {dup /ImageMask false put} if
      dup /ImageMask get
      {
         dup /Width get exch
         dup /Height get exch
         dup /Decode get 0 get 1 eq exch
         dup /ImageMatrix get exch
         /DataSource get
         imagemask
      }
      {
         dup /Width get exch
         dup /Height get exch
         dup /BitsPerComponent get exch
         dup /ImageMatrix get exch
         /DataSource get image
      } ifelse
   } bind def
}
{
   /ID
   {
      5 counttomark 2 idiv
      dup 3 1 roll add
      dict begin
      {exch GetTrueName exch def} repeat
      cleartomark
      /ImageMatrix [Width 0 0 Height neg 0 Height] def
      /ImageType 1 def
      currentdict end
      dup /ImageMask known not {dup /ImageMask false put} if
      dup /ImageMask get not
      {
         dup /ColorSpace known {dup /ColorSpace get setcolorspace} if
